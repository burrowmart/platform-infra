# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

aws_region     = "eu-central-1"
aws_account_id = "123456789012"

cluster_name = "archtenet-demo"

# ---------------------------------------------------------------------------
# Cost knobs (see README.md for the full monthly breakdown)
# ---------------------------------------------------------------------------
# t3.large  (8 GiB) — the whole stack fits
# t3.medium (4 GiB) — ~half the price; only with replicas=1 and no observability
instance_type    = "t3.large"
use_spot         = true
root_volume_size = 40

# Leave empty: API access goes through `make tunnel` (SSM port-forward), so
# the security group has zero inbound rules. Set e.g. ["203.0.113.4/32"] only
# if you deliberately want to hit 6443 directly.
api_allowed_cidrs = []

# Must be globally unique. Leave commented to get "<cluster_name>-oidc-<random>".
# oidc_bucket_name = "archtenet-demo-oidc"

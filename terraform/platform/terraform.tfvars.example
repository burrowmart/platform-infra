# Copy to terraform.tfvars (gitignored) and fill in. Never commit real
# account IDs, zone IDs, or tokens in this file — cloudflare_api_token in
# particular should come from TF_VAR_cloudflare_api_token or a secrets
# manager, not a checked-in tfvars file.

# Must match ../cluster/terraform.tfvars.
aws_region     = "eu-central-1"
aws_account_id = "111122223333"

# Where the ../cluster root's state lives. Everything needed to reach the
# cluster (kubeconfig parameter, OIDC provider, instance id) is read from it.
cluster_state_path = "../cluster/terraform.tfstate"

# Leave unset: the kubeconfig points at https://127.0.0.1:6443 and reaches the
# API server through the SSM port-forward (`make tunnel`). Only set this if
# you opened 6443 directly via the cluster root's api_allowed_cidrs.
# k8s_api_url = "https://<node-eip>:6443"

# "ssm" (default, free) or "secretsmanager" ($0.40/secret/month x 60 secrets).
secrets_backend = "ssm"


cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"
# cloudflare_api_token — leave unset here; export TF_VAR_cloudflare_api_token instead.

base_domain = "internal.archtenet.com"
tunnel_name = "archtenet-internal"

github_owner = "archtenet"
# github_repo_patterns defaults to ["archtenet/*"] on refs/heads/main if left unset.

opa_bundle_bucket_name = "archtenet-opa-bundles-111122223333"

tags = {
  Project     = "archtenet"
  ManagedBy   = "terraform"
  Environment = "demo"
}

# secret_values — leave out of any committed file. Populate via a gitignored
# secrets.auto.tfvars or TF_VAR_secret_values, e.g.:
#
# secret_values = {
#   user-service = {
#     mongo-uri = "mongodb+srv://..."
#   }
# }

{
  "uid": "saga-health",
  "title": "Saga Health",
  "description": "DLQ depth (rabbitmq_prometheus plugin) and saga_log terminal-state counts (saga-metrics-exporter) for the order-placement saga.",
  "tags": ["archtenet", "saga"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "DLQ Depth by Queue",
      "description": "rabbitmq_queue_messages for every queue matching the <queue>.dlq dead-letter naming convention (see order-service/src/order-orchestrator/saga-replies.consumer.ts)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=~\".+\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Dead-Lettered Messages",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages{queue=~\".+\\\\.dlq\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "In-Flight Sagas",
      "description": "saga_log documents not yet in a terminal state (STARTED / INVENTORY_RESERVED / PAYMENT_SUCCEEDED)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(saga_terminal_state_total{state!~\"CONFIRMED|CANCELLED\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saga Terminal States",
      "description": "saga_terminal_state_total{state=~\"CONFIRMED|CANCELLED\"} — see saga-metrics-exporter",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "saga_terminal_state_total{state=~\"CONFIRMED|CANCELLED\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "All Queue Depths (excl. DLQs)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue!~\".+\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    }
  ]
}

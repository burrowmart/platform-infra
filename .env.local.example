# Copy to .env.local (gitignored) and fill in, then:  source platform-infra/.env.local
#
# MongoDB Atlas connection string WITHOUT a trailing database name — the deploy
# script appends one per service (user-service, order-service, ...). Get it from
# Atlas → Database → Connect → Drivers, then strip the "/<dbname>?..." suffix.
export MONGO_BASE_URI='mongodb+srv://platform:PASSWORD@cluster0.xxxxx.mongodb.net'
